# ============================================================================
# UniTask AI - Muhit O'zgaruvchilari Namunalari (.env.example)
# ============================================================================

# 1. SERVER VA XAVFSIZLIK
PORT=3000
NODE_ENV=development
JWT_SECRET=unitask_secret_jwt_key_2025_secure_edtech_platform

# 2. MA'LUMOTLAR BAZASI (DATABASE CONFIG)
# DB_CLIENT: 'sqlite' yoki 'turso'
DB_CLIENT=sqlite

# 2.1. SQLite varianti (Lokal yoki Render Starter + Persistent Disk):
DB_PATH=./unitask.db

# 2.2. Turso varianti (100% Bepul Serverless Bulutli Baza - https://turso.tech):
# TURSO_DATABASE_URL=libsql://your-database-slug.turso.io
# TURSO_AUTH_TOKEN=your_turso_jwt_auth_token

# 3. SUN'IY INTELLEKT (OPENAI GPT)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
